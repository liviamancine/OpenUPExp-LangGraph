# Copie para .env e preencha. As chaves de LLM só são lidas pelo worker.
DB_PASSWORD=openupexp
DB_PORT=5433
API_PORT=8010
WEB_PORT=5173

# Segredo para assinar os tokens JWT da API
JWT_SECRET=troque-este-segredo

# Embeddings: "sentence-transformers" (real) ou "hash" (determinístico, só para testes)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-base
INSTALL_EMBEDDINGS=true

# Gateway de agentes: "baml" (LLM real) ou "fake" (fixtures, sem LLM)
AGENT_GATEWAY=baml
# Perfil BAML padrão (ver backend/baml_src/clients.baml)
LLM_PROFILE=OpenUPExpDefault

# Provedores LLM (preencha os que usar)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modelo local (Ollama) — OPCIONAL e desligado por padrão (cap. 14). Sem GPU ele é lento e
# pesado. Para ligar: LOCAL_LLM_ENABLED=true e `docker compose --profile local-llm up -d`.
LOCAL_LLM_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_PORT=11435
# Teto de recursos do container do modelo local
OLLAMA_CPUS=4
OLLAMA_MEM_LIMIT=6g
